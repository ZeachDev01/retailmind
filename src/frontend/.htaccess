Options -Indexes

<FilesMatch "^.*\.(joblib|pyc|log|sql)$">
    Require all denied
</FilesMatch>

# Compression: Deflate/Gzip text and asset payloads to reduce bandwidth and latency
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# Browser Caching: cache static assets locally to avoid redundant HTTP requests
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico|woff2?)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # This directory has its own rewrite rules, so it also needs the HTTPS redirect.
    RewriteCond %{HTTP_HOST} ^retailmind\.infinityfreeapp\.com(?::80)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://retailmind.infinityfreeapp.com%{REQUEST_URI} [R=308,L]

    RewriteRule ^Sidebar/(.*)$ components/$1 [L,QSA]
    RewriteRule ^admin/(.*)$ components/system_administrator/$1 [L,QSA]
    RewriteRule ^manager/(.*)$ components/inventory_management/$1 [L,QSA]
    RewriteRule ^invoice/(.*)$ components/invoice/$1 [L,QSA]
    RewriteRule ^notification/(.*)$ components/notification/$1 [L,QSA]
    RewriteRule ^api/(.*)$ barcodeScanner/apiScanner/$1 [L,QSA]
    RewriteRule ^barcodeScanner/api/(.*)$ barcodeScanner/apiScanner/$1 [L,QSA]
</IfModule>
