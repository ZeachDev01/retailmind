# RetailMind Remote Ingress Environment Configuration Template
# Store PC configuration (e.g. SetEnv in Apache VirtualHost or system environment)
# DO NOT commit real secrets, credentials, or actual owner emails to source control.

# Enable remote ingress enforcement
RETAILMIND_REMOTE_INGRESS=1

# Dedicated remote monitoring listener port (loopback only)
RETAILMIND_REMOTE_PORT=8081

# Dedicated remote monitoring hostname
RETAILMIND_REMOTE_HOST=monitor.your-store-domain.com

# Shared tunnel secret header verification (optional defense-in-depth between tunnel and web server)
RETAILMIND_TUNNEL_SECRET=your-random-shared-tunnel-secret

# Owner exact email gate (matches Cloudflare Access policy single-email Allow rule)
RETAILMIND_REMOTE_OWNER_EMAIL=owner@your-store-domain.com

# Cloudflare Access Application AUD tag (from Cloudflare Zero Trust dashboard)
RETAILMIND_CF_ACCESS_AUD=your-application-aud-tag-from-cloudflare

# Cloudflare Access Zero Trust Team Name (e.g. "myteam" in https://myteam.cloudflareaccess.com)
RETAILMIND_CF_ACCESS_TEAM=your-zerotrust-team-name

# Enforce Access JWT token presence and claim validation on remote ingress (1/true)
RETAILMIND_REQUIRE_ACCESS_TOKEN=1

# Optional: Cloudflare Access Public Key PEM for local RS256 signature verification
# (Available from https://<teamName>.cloudflareaccess.com/cdn-cgi/access/certs)
# RETAILMIND_CF_ACCESS_PUBKEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
