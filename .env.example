APP_NAME=RetailMind
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/inventory_system
APP_TIMEZONE=Asia/Manila

SESSION_NAME=retailmind_session
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
SESSION_SAVE_PATH=storage/sessions
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_system
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Random Forest Flask service. Use a long, random API key in both PHP and Python.
ML_API_URL=http://127.0.0.1:5000
ML_API_KEY=replace-with-a-long-random-secret
ML_API_TIMEOUT=30
ML_API_HOST=127.0.0.1
ML_API_PORT=5000

# Transactional email. Use Brevo API with MAIL_MAILER=brevo, or SMTP with MAIL_MAILER=smtp.
MAIL_MAILER=brevo
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=RetailMind
BREVO_API_KEY=
MAIL_TIMEOUT=30
MAIL_CAINFO=

# Comma-separated additional origins only when the scanner is hosted elsewhere.
# Same-origin phone scanning does not require this value.
BARCODE_ALLOWED_ORIGINS=

# Optional Android Debug Bridge executable for wired scanning.
ADB_PATH=

# Persistent private directory OUTSIDE the application and web document root.
# Grant access only to the PHP service account and trusted recovery operators.
# Contains plaintext SQL, latest safety backup, restore log, and recovery state.
# Default: two directories above the project, in retailmind-private-<path hash>.
# Set an absolute path explicitly in production; never use temporary storage.
BACKUP_STORAGE_PATH=

# Legacy .rmbak keys are no longer used by the application. Keep existing keys
# and encrypted files separately until replacement SQL backups are verified.
