# Copy to .env and replace placeholders with your own values.
APP_NAME=RetailMind
APP_ENV=development
APP_DEBUG=false
APP_URL=http://localhost/retailmind
APP_TIMEZONE=Asia/Manila

# Permanent HTTPS URL of the RetailMind logo uploaded to the Brevo image library.
# Leave blank to use the RetailMind text wordmark; never use localhost or a tunnel URL.
MAIL_LOGO_URL=https://img.mailinblue.com/12150953/images/content_library/original/6af92f9d4ba171fc965746a2.png

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4

ML_API_URL=http://127.0.0.1:5000
ML_API_KEY=your_ml_api_key
ML_API_TIMEOUT=30
