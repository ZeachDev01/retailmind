APP_NAME=RetailMind
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/inventory_system
APP_TIMEZONE=Asia/Manila

SESSION_NAME=retailmind_session
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
SESSION_SAVE_PATH=storage/sessions
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_system
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Random Forest Flask service. Use a long, random API key in both PHP and Python.
ML_API_URL=http://127.0.0.1:5000
ML_API_KEY=replace-with-a-long-random-secret
ML_API_TIMEOUT=30
ML_API_HOST=127.0.0.1
ML_API_PORT=5000

# Transactional email. Use Brevo API with MAIL_MAILER=brevo, or SMTP with MAIL_MAILER=smtp.
MAIL_MAILER=brevo
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=RetailMind
BREVO_API_KEY=
MAIL_TIMEOUT=30
MAIL_CAINFO=

# Comma-separated additional origins only when the scanner is hosted elsewhere.
# Same-origin phone scanning does not require this value.
BARCODE_ALLOWED_ORIGINS=

# Optional Android Debug Bridge executable for wired scanning.
ADB_PATH=

# Database Backup recovery key (ticket #69). 32 random bytes as 64 hex
# characters or standard base64, held on the server only. The developer team
# acting as Super Administrator keeps a separate copy in its password manager:
# after server loss BOTH the encrypted backup file and this key are required,
# and an old file is only usable while its matching key is retained.
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Without this value encrypted backups fail closed; there is no plaintext
# fallback and the key is never stored in the exported database.
BACKUP_ENCRYPTION_KEY=
