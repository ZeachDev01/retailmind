{
    "autoload": {
        "psr-4": {
            "App\\": "src/backend/app/"
        }
    },
    "require": {
        "php": ">=8.1",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "phpmailer/phpmailer": "^6.10"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "build:styles": "php src/backend/scripts/build_styles.php",
        "check": "php src/backend/tests/smoke_checks.php",
        "seed:products": "php src/backend/scripts/seed_products.php",
        "seed:sales-trend": "php src/backend/scripts/seed_sales_trend.php --confirm-local"
    }
}
