.env
/vendor/
/node_modules/
/backend/storage/logs/*
!/backend/storage/logs/.gitkeep
/src/backend/storage/logs/*
!/src/backend/storage/logs/.gitkeep
/backend/storage/backups/*
!/backend/storage/backups/.gitkeep
/src/backend/storage/sessions/*
!/src/backend/storage/sessions/.gitkeep
/src/backend/storage/bin/*
!/src/backend/storage/bin/.gitkeep
/src/backend/storage/tunnel/*
!/src/backend/storage/tunnel/.gitkeep
/src/backend/storage/profile-images/*
!/src/backend/storage/profile-images/.gitkeep
!/src/backend/storage/profile-images/.htaccess
/src/backend/database/sql/backup_schema.sql
/backend/storage/imports/*
!/backend/storage/imports/.gitkeep
/backend/storage/exports/*
!/backend/storage/exports/.gitkeep
/backend/storage/receipts/*
!/backend/storage/receipts/.gitkeep
**/__pycache__/
*.pyc
*.joblib
.release/
.scratch/
.agents/
skills/
skills-lock.json

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
.worktrees/

# Generated browser captures and scratch output
/tmp/
/output/

# Recovery storage created when a test runs inside a worktree (dirname() of the
# worktree project lands in this repo); the install default is a sibling folder.
/retailmind-private-*/

# Design review captures (surface briefs stay tracked)
/.impeccable/review/
/.impeccable/build/
/.impeccable/mocks/
/.impeccable/config.local.json
/.impeccable/hook.cache.json
/.impeccable/hook.pending.json

# Machine-generated forecasting runner config
/src/backend/config/forecasting_runner.json

# Generated model artifacts
/src/backend/storage/ml_models/*.joblib
