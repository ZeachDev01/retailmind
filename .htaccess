Options -Indexes

<IfModule mod_php.c>
    php_value upload_max_filesize 12M
    php_value post_max_size 16M
    php_value memory_limit 512M
</IfModule>

<FilesMatch "^(\.env.*|\.git.*|\.user\.ini|\.ftp-deploy-sync-state\.json|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|.*\.(joblib|pyc|log|sql|sqlite|db|rmpkg|bak|dump))$">
    Require all denied
</FilesMatch>

# Compression: Deflate/Gzip text and asset payloads to reduce bandwidth and latency
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml font/woff2
</IfModule>

# Browser Caching: cache static assets locally to avoid redundant HTTP requests
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico|woff2?)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    <FilesMatch "^sw\.js$">
        Header set Service-Worker-Allowed "/"
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(?:git|svn|hg|env)(?:/|$) - [F,L]
    RewriteRule ^backend(?:/|$) - [F,L]
    RewriteRule ^src/(?:backend|vendor|storage)(?:/|$) - [F,L]
    RewriteRule ^assets/bootstrap(?:/|$) - [F,L]
    RewriteRule ^(?:app|config|database|includes|demandForcasting|legacy|scripts|sql|storage|tests|vendor)(?:/|$) - [F,L]
    RewriteRule (?:^|/)(?:storage/backups|backups|database/backups)(?:/|$) - [F,L]
    RewriteRule (?:^|/)(?:tests?|phpunit|.*_test\.php|.*Test\.php)(?:/|$|\?) - [F,NC,L]
    RewriteRule \.(?:sql|env|log|bak|dump|sqlite|db|joblib|pyc|rmpkg)(?:$|\?) - [F,NC,L]
    RewriteRule ^sw\.js$ src/frontend/sw.js [L]
    RewriteRule ^Sidebar/(.*)$ frontend/modules/$1 [L,QSA]
    RewriteRule ^admin/(.*)$ frontend/modules/system_administrator/$1 [L,QSA]
    RewriteRule ^manager/(.*)$ frontend/modules/inventory_management/$1 [L,QSA]
    RewriteRule ^invoice/(.*)$ frontend/modules/invoice/$1 [L,QSA]
    RewriteRule ^notification/(.*)$ frontend/modules/notification/$1 [L,QSA]
    RewriteRule ^api/(.*)$ frontend/barcodeScanner/apiScanner/$1 [L,QSA]
    RewriteRule ^barcodeScanner/api/(.*)$ frontend/barcodeScanner/apiScanner/$1 [L,QSA]
    RewriteRule ^(assets|barcodeScanner|cashier|modules|report)(/.*)?$ frontend/$1$2 [L,QSA]
</IfModule>
